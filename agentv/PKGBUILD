# AgenTV's own package: everything AgenTV adds to a box, beside Omarchy's
# package and never inside /usr/share/omarchy, which Omarchy's update owns
# (ADR-025). CI builds it from agentv-os: at a release tag for stable, at the
# newest green commit of agentv for edge.
#
# Where the source is and where updates come from are set by the build, not
# written here, so moving the repos to another owner changes no code:
#   AGENTV_SOURCE    git URL of agentv-os
#   AGENTV_REF       tag=v0.1.0 or commit=<sha>
#   AGENTV_CHANNEL   stable or edge
#   AGENTV_REPO_URL  https://github.com/<owner>/agentv-pkgs/releases/download

pkgname=agentv
pkgver=0.0.0
pkgrel=1
pkgdesc="AgenTV, a TV OS whose own agent builds the apps it's missing. Powered by Omarchy"
arch=(any)
url="${AGENTV_SOURCE%.git}"
license=(MIT LicenseRef-AgenTV-sounds)
options=(!debug)
# nodejs runs the screen daemon's TypeScript as it is, gamescope runs Steam
# in the TV session, and quickshell draws its toasts (ADR-031).
# git and gnupg fetch and check apps from the signed app index, and
# pacman-contrib's checkupdates and polkit look for and install updates from
# the TV.
# Music (ADR-017) reads tags and covers with ffmpeg, plays through mpv with
# mpv-mpris, mounts USB drives through udisks2 and shares through gvfs.
# Omarchy has them all today; naming them keeps Music working if it doesn't.
# The setup hotspot hands phones their addresses with dnsmasq, which Omarchy
# doesn't have, through NetworkManager and iptables, which it does.
# A NAS share with a password is mounted by root with mount.cifs (ADR-038),
# from cifs-utils, which Omarchy doesn't have either.
depends=(omarchy agentv-keyring bash chromium cifs-utils curl dnsmasq ffmpeg gamescope git gnupg gvfs gvfs-nfs gvfs-smb hyprland iptables jq mpv mpv-mpris
  networkmanager nodejs pacman-contrib polkit python quickshell udisks2 uwsm)
makedepends=(git)
install=agentv.install
source=("agentv-os::git+${AGENTV_SOURCE:?set AGENTV_SOURCE}#${AGENTV_REF:?set AGENTV_REF}")
sha256sums=(SKIP)

pkgver() {
  cd agentv-os

  # A release is its tag, v0.1.0 -> 0.1.0. Between releases it's the last one
  # plus commits, 0.1.0.r3.gabc1234, which sorts after 0.1.0 and before 0.1.1.
  # Omarchy's own tags in this history start at v1, so v0.* is only AgenTV's
  # while AgenTV is 0.x (phase 1).
  if git describe --exact-match --tags --match 'v0.*' >/dev/null 2>&1; then
    git describe --exact-match --tags --match 'v0.*' | sed 's/^v//'
  elif git describe --long --tags --match 'v0.*' >/dev/null 2>&1; then
    git describe --long --tags --match 'v0.*' | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
  else
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

package() {
  : "${AGENTV_CHANNEL:?set AGENTV_CHANNEL}"
  : "${AGENTV_REPO_URL:?set AGENTV_REPO_URL}"
  cd agentv-os

  local share="$pkgdir/usr/share/agentv"
  local file

  # Commands. bin/agentv-check is the developers' gate, not the box's.
  for file in bin/agentv bin/agentv-*; do
    [[ ${file##*/} == agentv-check ]] && continue
    install -Dm755 "$file" "$pkgdir/usr/bin/${file##*/}"
  done

  # AgenTV's migrations, run by its post-update hook.
  install -d "$share/migrations"
  for file in migrations/agentv/*.sh; do
    [[ -f $file ]] && install -Dm644 "$file" "$share/migrations/${file##*/}"
  done

  # Hooks into Omarchy's update. First boot copies them into the owner's
  # ~/.config, and /etc/skel hands them to any user made after this package.
  for file in config/omarchy/hooks/*/agentv; do
    install -Dm644 "$file" "$share/$file"
    install -Dm644 "$file" "$pkgdir/etc/skel/.$file"
  done

  # First boot, the daemon, the TV session's own Hyprland setup and toasts,
  # the app contract and the built-in apps, the home screen, the template
  # that gives it the Omarchy theme's colours, the phone companion's page,
  # and the TV setup screens. A folder that isn't in this commit of agentv-os
  # yet is skipped, so older refs still build.
  for file in install/tv/*.sh daemon/*.py daemon/*.ts daemon/package.json session/*.lua session/toast/*.qml \
    daemon/apps/*.ts apps/package.json apps/contract/*.ts apps/builtin/*/* \
    launcher/*.html launcher/*.css launcher/*.ts launcher/package.json launcher/pages/*.ts launcher/sounds/*.ogg \
    companion-web/*.html companion-web/*.css companion-web/*.ts \
    config/omarchy/themed/*.tpl \
    setup/welcome/* branding/logo.svg branding/logo.txt branding/plymouth-logo.png; do
    [[ -f $file ]] && install -Dm644 "$file" "$share/$file"
  done

  # The TV session, for the login manager (ADR-031).
  if [[ -f session/agentv.desktop ]]; then
    install -Dm644 session/agentv.desktop "$pkgdir/usr/share/wayland-sessions/agentv.desktop"
  fi

  # The TV session's own units: the screen daemon, the virtual input device
  # and the toasts, under agentv-tv.target, which the session starts itself.
  for unit in system/user/*.service system/user/*.target; do
    [[ -f $unit ]] && install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/user/${unit##*/}"
  done

  # udev rules, such as the one that lets the person on the screen make the
  # virtual input device.
  for rule in system/*.rules; do
    [[ -f $rule ]] && install -Dm644 "$rule" "$pkgdir/usr/lib/udev/rules.d/${rule##*/}"
  done

  # AgenTV's units, timers and path units. The package enables each one its
  # [Install] section asks for, so the installer needs no extra step:
  # agentv-firstboot.service only ever runs once, agentv-update-tv.service,
  # with no [Install], only runs when the TV starts it, and agentv-key.path
  # starts agentv-key.service when the daemon hands over a key.
  for unit in system/*.service system/*.timer system/*.path; do
    [[ -f $unit ]] || continue
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/system/${unit##*/}"
    target=$(sed -n 's/^WantedBy=//p' "$unit" | head -n 1)
    [[ -n $target ]] || continue
    install -d "$pkgdir/usr/lib/systemd/system/$target.wants"
    ln -s "../${unit##*/}" "$pkgdir/usr/lib/systemd/system/$target.wants/${unit##*/}"
  done

  # polkit rules, such as the one that lets the person at the TV check for
  # updates and install them.
  for rule in system/polkit/*.rules; do
    [[ -f $rule ]] && install -Dm644 "$rule" "$pkgdir/usr/share/polkit-1/rules.d/${rule##*/}"
  done

  # NetworkManager's defaults for AgenTV, such as wake-on-LAN on every wired
  # connection. Package-owned, so /etc stays the owner's.
  for conf in system/networkmanager/*.conf; do
    [[ -f $conf ]] && install -Dm644 "$conf" "$pkgdir/usr/lib/NetworkManager/conf.d/${conf##*/}"
  done

  # tmpfiles.d entries, such as the folder Music leaves its NAS share
  # requests in for root (ADR-038). pacman's own hook makes them on install.
  for conf in system/tmpfiles/*.conf; do
    [[ -f $conf ]] && install -Dm644 "$conf" "$pkgdir/usr/lib/tmpfiles.d/${conf##*/}"
  done

  # AgenTV's pacman hooks, such as the one that keeps its logo on the boot
  # splash when Omarchy's settings package puts Omarchy's back.
  for hook in system/*.hook; do
    [[ -f $hook ]] && install -Dm644 "$hook" "$pkgdir/usr/share/libalpm/hooks/${hook##*/}"
  done

  # Where this box's updates come from, read by agentv-pacman-conf, where its
  # apps come from, read by agentv app install, and AgenTV's own address,
  # which every request an app makes names (MET Norway asks for one). The
  # app index is a release of agentv-apps, beside agentv-os (ADR-036).
  printf '%s\n' \
    "AGENTV_VERSION=$pkgver" \
    "AGENTV_HOMEPAGE=${AGENTV_SOURCE%.git}" \
    "AGENTV_CHANNEL=$AGENTV_CHANNEL" \
    "AGENTV_REPO_URL=$AGENTV_REPO_URL" \
    "AGENTV_TESTED_URL=${AGENTV_SOURCE%.git}/releases/download/tested" \
    "AGENTV_INDEX_URL=${AGENTV_SOURCE%/agentv-os.git}/agentv-apps/releases/download/index" >"$share/settings"
  chmod 644 "$share/settings"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The home screen's sounds aren't MIT: they ship only with AgenTV.
  if [[ -f launcher/sounds/LICENSE ]]; then
    install -Dm644 launcher/sounds/LICENSE "$pkgdir/usr/share/licenses/$pkgname/sounds"
  fi
}
