#!/bin/bash

# Makes a throwaway signing key for one test run: a pull request's, a
# branch's or a sync's. Those runs build and sign packages from code nobody
# has reviewed yet, so they never get AgenTV's own key. They sign with this
# one, and only the run's own test box trusts it (bin/build with
# AGENTV_TEST_KEY). It has no passphrase and stops working after a day.
#
# Leaves three files in <dir>:
#   secret.asc   the key, for bin/sign's AGENTV_SIGNING_KEY
#   public.asc   its public half, for AGENTV_TEST_KEY
#   fingerprint  its fingerprint, on one line
#
# Usage: bin/test-key <dir>

set -euo pipefail

dir="${1:?usage: bin/test-key <dir>}"
mkdir -p "$dir"
dir=$(realpath "$dir")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GNUPGHOME="$work/gnupg"
mkdir -m 700 "$GNUPGHOME"

gpg --batch --quiet --passphrase '' --quick-generate-key "AgenTV test run (throwaway, trusted by nothing else)" ed25519 sign 1d
fpr=$(gpg --batch --with-colons --list-secret-keys | awk -F: '$1 == "fpr" { print $10; exit }')

(umask 077 && gpg --batch --armor --export-secret-keys "$fpr" >"$dir/secret.asc")
gpg --batch --armor --export "$fpr" >"$dir/public.asc"
printf '%s\n' "$fpr" >"$dir/fingerprint"

echo "A throwaway key for this run, good for a day: $fpr"
