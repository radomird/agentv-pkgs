#!/bin/bash

# Builds agentv, agentv-keyring and agentv-voice into a pacman repository in
# <repo-dir>. A package that's already there at the same version is kept as
# it is, so a box never sees two different files for one version. Runs as
# root in an Arch container; makepkg runs as a throwaway user.
#
# Nothing is signed here. bin/sign signs what this leaves, afterwards and
# outside this container, so the signing key is never near pacman, makepkg
# or the code being packaged. Nothing is published before that.
#
# With AGENTV_TEST_KEY, the public half of a throwaway key (bin/test-key),
# the agentv-keyring built here trusts that key as well as AgenTV's. That's
# for a pull request's or a branch's test run, whose packages are signed
# with the throwaway key and never leave the run. A release build never
# sets it.
#
# Usage: bin/build <repo-dir>
# Needs: AGENTV_CHANNEL, AGENTV_SOURCE, AGENTV_REF and AGENTV_REPO_URL.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
repo=$(realpath "${1:?usage: bin/build <repo-dir>}")

: "${AGENTV_CHANNEL:?}" "${AGENTV_SOURCE:?}" "${AGENTV_REF:?}" "${AGENTV_REPO_URL:?}"
# A key has no business in this container, so a caller that hands one over
# is stopped here, before pacman or makepkg run anywhere near it.
if [[ -n ${AGENTV_SIGNING_KEY:-} ]]; then
  echo "::error::bin/build signs nothing, so it takes no AGENTV_SIGNING_KEY. Build first, then run bin/sign with the key, outside this container." >&2
  exit 1
fi
if [[ -n ${AGENTV_TEST_KEY:-} && ! -f $AGENTV_TEST_KEY ]]; then
  echo "::error::AGENTV_TEST_KEY names a throwaway key's public half, and $AGENTV_TEST_KEY isn't a file" >&2
  exit 1
fi

# shellcheck source=bin/arch-container-setup
source "$ROOT/bin/arch-container-setup"
arch_container_setup base-devel git jq

useradd -m builder
work=/home/builder/work
mkdir -p "$work"
cp -r "$ROOT/agentv" "$ROOT/agentv-keyring" "$ROOT/agentv-voice" "$work/"
chown -R builder:builder "$work"

as_builder() {
  setpriv --reuid=builder --regid=builder --init-groups \
    env HOME=/home/builder GNUPGHOME=/home/builder/.gnupg \
    AGENTV_CHANNEL="$AGENTV_CHANNEL" AGENTV_SOURCE="$AGENTV_SOURCE" \
    AGENTV_REF="$AGENTV_REF" AGENTV_REPO_URL="$AGENTV_REPO_URL" "$@"
}

as_builder mkdir -m 700 -p /home/builder/.gnupg

# A test run's keyring trusts the run's throwaway key too, in the copy this
# build works on. The files in the repo stay AgenTV's key alone.
if [[ -n ${AGENTV_TEST_KEY:-} ]]; then
  install -m 644 -o builder -g builder "$AGENTV_TEST_KEY" "$work/test-key.asc"
  as_builder "$ROOT/bin/test-keyring" "$work/agentv-keyring" "$work/test-key.asc"
fi

# What a published package's signature is checked against: the keys this
# build's agentv-keyring carries, and no others.
as_builder gpg --batch --quiet --yes --dearmor --output "$work/trusted.gpg" "$work/agentv-keyring/agentv.gpg"

current=()
for pkg in agentv-keyring agentv-voice agentv; do
  cd "$work/$pkg"

  # Fetch the source and run pkgver(), so the package list has the version
  # this build would make.
  as_builder makepkg --nobuild --nodeps --noprepare >/dev/null

  # The image layer's update test (S0.5) builds the same commit again with a
  # higher pkgrel, to have something newer to update to. makepkg puts pkgrel
  # back to 1 whenever pkgver() moves the version, so this goes in after it.
  if [[ $pkg == agentv && -n ${AGENTV_PKGREL:-} ]]; then
    as_builder sed -i "s/^pkgrel=.*/pkgrel=$AGENTV_PKGREL/" PKGBUILD
  fi
  mapfile -t files < <(as_builder makepkg --packagelist)

  missing=0
  for file in "${files[@]}"; do
    current+=("${file##*/}")
    [[ -f $repo/${file##*/} && -f $repo/${file##*/}.sig ]] || missing=1
  done

  if (( missing == 0 )); then
    echo "Keeping $pkg ${files[*]##*/}, already published"
    continue
  fi

  echo "Building $pkg"
  as_builder makepkg --force --nodeps >/dev/null
  for file in "${files[@]}"; do
    # A signature left from another build of this name isn't this file's.
    rm -f "$repo/${file##*/}.sig"
    cp "$file" "$repo/"
  done
done

cd "$repo"

# Only this build's packages are in the repository.
for file in *.pkg.tar.*; do
  [[ -f $file ]] || continue
  name=${file%.sig}
  printf '%s\n' "${current[@]}" | grep -qxF "$name" || rm -f "$file"
done
rm -f agentv.db* agentv.files*

# A package kept from what's published has its signature. One built just now
# has none yet: bin/sign gives it one.
chown -R builder "$repo"
for name in "${current[@]}"; do
  [[ -f $name.sig ]] || continue
  as_builder gpgv --quiet --keyring "$work/trusted.gpg" "$name.sig" "$name"
done

as_builder repo-add --quiet agentv.db.tar.gz "${current[@]}"

# release.json, for Settings → Updates (ADR-025): the version, the date, a
# security flag and What's new, signed like the packages (bin/sign). What's
# new comes from agentv-os's release-notes/<version>.txt, up to five lines,
# for a release; a first line of "security" marks a security release. Edge
# builds have no notes.
version=$(printf '%s\n' "${current[@]}" | sed -nE 's/^agentv-([0-9][^-]*)-[0-9]+-any\.pkg\.tar\.zst$/\1/p' | head -n 1)
source_dir="$work/agentv/src/agentv-os"
notes_file="$source_dir/release-notes/$version.txt"
date=$(git -C "$source_dir" log -1 --format=%cI 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)
security=false
notes=()
if [[ -f $notes_file ]]; then
  mapfile -t notes < <(grep -v '^[[:space:]]*$' "$notes_file")
  if [[ ${notes[0]:-} == "security" ]]; then
    security=true
    notes=("${notes[@]:1}")
  fi
fi
jq -n --arg version "$version" --arg date "$date" --arg channel "$AGENTV_CHANNEL" --argjson security "$security" \
  '{version: $version, date: $date, channel: $channel, security: $security, notes: ($ARGS.positional[:5])}' \
  --args ${notes[@]+"${notes[@]}"} >release.json
rm -f release.json.sig
cat release.json

# GitHub release assets can't be symlinks, so pacman's names become copies.
# bin/sign makes the signatures' copies.
for db in agentv.db agentv.files; do
  rm -f "$db" "$db.sig"
  cp "$db.tar.gz" "$db"
done

ls -l "$repo"
