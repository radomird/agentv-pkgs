# The TV's own voice (stage 8, Q157): Piper and its cori voice, which say
# the TV's answers aloud when the household's AI provider has no voice of
# its own (Claude, Muse, a plan), and whenever that voice doesn't answer.
# It's a package of its own beside agentv, so the TV can speak from its
# first boot without fetching anything, and so it's built once per version
# rather than with every agentv commit.
#
# Piper's last MIT release, built for x86_64 by its authors, with the
# libraries it needs beside it (onnxruntime, MIT; espeak-ng, GPL-3.0 or
# later), and the cori voice: British English, trained on LibriVox
# recordings, which are public domain. Each file is checked against its
# checksum below. agentv's daemon runs piper from /usr/lib/agentv-voice.
pkgname=agentv-voice
pkgver=2023.11.14.2
pkgrel=1
pkgdesc="Piper and its cori voice, for AgenTV's spoken answers"
arch=(x86_64)
url="https://github.com/rhasspy/piper"
license=(MIT GPL-3.0-or-later LicenseRef-public-domain)
# Prebuilt by Piper's authors: nothing to strip, and no debug package.
options=(!strip !debug)
_release=2023.11.14-2
_voice=en_GB-cori-medium
_voices=https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_GB/cori/medium
source=("piper-$_release.tar.gz::https://github.com/rhasspy/piper/releases/download/$_release/piper_linux_x86_64.tar.gz"
  "piper-$_release-LICENSE.md::https://raw.githubusercontent.com/rhasspy/piper/$_release/LICENSE.md"
  "$_voice.onnx::$_voices/$_voice.onnx"
  "$_voice.onnx.json::$_voices/$_voice.onnx.json"
  "$_voice-MODEL_CARD::$_voices/MODEL_CARD")
noextract=("$_voice.onnx")
sha256sums=(a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992
  4cd71dece7037f1d6d93cce7570c57ab75ea9ac566fd4990be2f3ab08d15b47f
  1899f98e5fb8310154f3c2973f4b8a929ba7245e722b3d3a85680b833d95f10d
  e262c16d7f192f69d4edd6b4ef8a5915379e67495fcc402f1ab15eeb33da3d36
  38d76dfde845837b184668f8bab1c6426ad740b1af0fcebc349037822739e536)

package() {
  local dir="$pkgdir/usr/lib/agentv-voice"
  install -d "$dir"
  # Piper's folder as its release has it: piper beside its libraries and
  # espeak-ng's data, which it finds there. -R keeps its symlinks, and the
  # copies are root's, not the build user's.
  cp -R piper "$dir/"
  chmod -R u=rwX,go=rX "$dir/piper"
  chmod 755 "$dir/piper/piper"
  install -Dm644 "$_voice.onnx" "$dir/$_voice.onnx"
  install -Dm644 "$_voice.onnx.json" "$dir/$_voice.onnx.json"
  install -Dm644 "piper-$_release-LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-piper.md"
  install -Dm644 "$_voice-MODEL_CARD" "$pkgdir/usr/share/licenses/$pkgname/MODEL_CARD-$_voice"
}
